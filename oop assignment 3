#include <iostream>
#include <string>
using namespace std;

class Employee {
private:
    string name;
    int id;
    string department;

public:
    void setDetails() {
        cout << "Enter employee name: ";
        getline(cin, name);

        cout << "Enter employee ID: ";
        cin >> id;
        cin.ignore();

        cout << "Enter department: ";
        getline(cin, department);
    }

    void displayDetails() {
        cout << "\n--- Employee Details ---" << endl;
        cout << "Name: " << name << endl;
        cout << "ID: " << id << endl;
        cout << "Department: " << department << endl;
    }
};

int main() {
    Employee E1;

    E1.set();
    E1.display();

    return 0;
}
