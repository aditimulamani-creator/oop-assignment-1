#include <iostream>
#include <string>
using namespace std;

class Book {
private:
    string title;
    string author;
    int price;

public:
    // Default constructor
    Book() {
        title = "Unknown";
        author = "Unknown";
        price = 0;
    }

    // Parameterized constructor
    Book(string t, string a, int p) {
        title = t;
        author = a;
        price = p;
    }

    void display() {
        cout << "\nTitle: " << title << endl;
        cout << "Author: " << author << endl;
        cout << "Price: " << price << endl;
    }
};

int main() {
    Book b1; 
    Book b2("C++ Programming", "Andrew", 500);

    cout << "--- Book 1 ---";
    b1.display();

    cout << "\n--- Book 2 ---";
    b2.display();

    return 0;
}
