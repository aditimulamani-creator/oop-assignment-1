#include <iostream>
#include <string>
using namespace std;

class Student {
private:
    string name;
    int rollNo;
    string branch;

public:
    void setDetails() {
        cout << "student name: ";
        getline(cin, name);

        cout << "roll number: ";
        cin >> rollNo;
        cin.ignore();

        cout << "branch: ";
        getline(cin, branch);
    }

    void displayDetails() {
        cout << "\n Student Details" << endl;
        cout << "simran:" << name << endl;
        cout << "49:" << rollNo << endl;
        cout << "soai:" << branch << endl;
    }
};

int main() {
    Student s;

    s.setDetails();
    s.displayDetails();

    return 0;
}
